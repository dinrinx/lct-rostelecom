DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_it_shkola_rtk?schema=public"
REDIS_URL="redis://localhost:6379"

# dev|keycloak — в dev-режиме роль берётся из заголовка X-Dev-Role вместо Keycloak-редиректа
AUTH_MODE=dev

# Realm и клиент импортируются из infra/keycloak/realm-export.json (см. infra/docker-compose.yml)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM=it-school-crm
KEYCLOAK_CLIENT_ID=it-school-crm-backend

PORT=3000

# MinIO (S3-совместимое хранилище вложений) — креды и бакет совпадают с
# infra/docker-compose.yml; бакет создаётся автоматически при старте backend,
# если ещё не существует.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=crm-minio
MINIO_SECRET_KEY=crm-minio-secret
MINIO_BUCKET=crm-attachments


# Необязательно: список Origin для CORS через запятую (по умолчанию разрешены все — прототип открывается с диска)
# CORS_ORIGINS=http://localhost:8123
