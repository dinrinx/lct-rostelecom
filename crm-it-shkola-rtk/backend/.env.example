DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_it_shkola_rtk?schema=public"
REDIS_URL="redis://localhost:6379"

# dev|keycloak — в dev-режиме роль берётся из заголовка X-Dev-Role вместо Keycloak-редиректа
AUTH_MODE=dev

# Realm и клиент импортируются из infra/keycloak/realm-export.json (см. infra/docker-compose.yml)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM=it-school-crm
KEYCLOAK_CLIENT_ID=it-school-crm-backend

PORT=3000

# Порог "зависания" в текущем статусе (дней) — используется и радаром SLA
# (GET /dashboard/sla-radar), и фильтром ?onlyOverdue=true в GET /reports/interactions,
# это одно и то же понятие "просрочено". По умолчанию 5, если не задано.
SLA_THRESHOLD_DAYS=5

# Разрешённые origin'ы фронта для CORS (через запятую). По умолчанию (если не
# задано) — localhost:5173/4200/3000/8081, те же порты, что в redirectUris
# infra/keycloak/realm-export.json. Поменяйте, если дев-сервер фронта на другом порту.
# CORS_ORIGINS=http://localhost:5173,http://localhost:4200

# S3-совместимое хранилище вложений — креды и бакет совпадают с тем, что
# infra/garage/init/init.sh заводит в Garage при первом старте. Название
# переменных осталось MINIO_* по истории (изначально был правда MinIO), но
# код (storage/minio.service.ts) — просто S3-клиент, ему всё равно, какой
# сервер за портом. Сейчас в docker-compose это Garage (dxflrs/garage) —
# в отличие от MinIO (закрыт на Docker Hub без логина) и scality/s3server
# (только linux/amd64, на Apple Silicon шёл через эмуляцию), Garage собран
# нативно и под arm64, и под amd64.
MINIO_ENDPOINT=localhost
MINIO_PORT=3900
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=GK8533518c26b556bb9a9dde7d
MINIO_SECRET_KEY=3918d67710daeb39d6d1b2cd780ae56b7eaa61d884dd0050163a0660dc4d3b88
MINIO_BUCKET=crm-attachments
# Garage (в отличие от MinIO/scality) реально проверяет регион в подписи
# запроса против своего s3_region (infra/garage/garage.toml) — без этого
# все запросы к хранилищу будут падать с "unexpected scope".
MINIO_REGION=garage

