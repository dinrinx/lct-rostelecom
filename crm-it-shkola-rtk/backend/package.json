{
  "name": "crm-it-shkola-rtk-backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node prisma/seed.ts",
    "docs:error-codes": "ts-node scripts/sync-error-codes-doc.ts",
    "export:openapi": "nest build && node dist/generate-openapi.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^6.19.3",
    "@willsoto/nestjs-prometheus": "^6.1.1",
    "bullmq": "^6.3.9",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "fastest-levenshtein": "^1.0.16",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "keyv": "^5.6.0",
    "minio": "^8.0.7",
    "nestjs-pino": "^5.2.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.3",
    "@types/pdfkit": "^0.17.6",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
