# Конфиг стенда docker-compose (Postgres, Redis, Garage/S3, Keycloak, backend).
# Скопируйте в .env рядом (cp .env.example .env) и поменяйте значения перед
# запуском на реальном сервере — см. infra/README.md, раздел "Перед боевым запуском".
#
# Это ОТДЕЛЬНЫЙ файл от backend/.env.example: тот — для локального запуска
# backend без Docker (npm run start:dev на голой машине), этот — для
# docker-compose, где Postgres/Redis/Garage/Keycloak адресуются по именам
# сервисов (postgres/redis/storage/keycloak), а не localhost.

# ==== Postgres ====
POSTGRES_USER=crm
# ОБЯЗАТЕЛЬНО смените перед реальным запуском — это учётка с полным доступом к БД.
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=crm_it_shkola_rtk

# ==== Garage (S3-совместимое хранилище вложений) ====
# rpc_secret узла: 64 шестнадцатеричных символа, сгенерировать перед боевым
# запуском можно так: openssl rand -hex 32
GARAGE_RPC_SECRET=62f2b5aaf323ebc6197e7db2aa912270fa747c438c3d343b7d0e593264b9a111
# Токен для админ-API Garage (используется storage-init) — любая непустая строка,
# сгенерировать: openssl rand -hex 16
GARAGE_ADMIN_TOKEN=4c60dc609d9760749137879e9b5e61f5
# Ключ доступа S3: Garage требует строгий формат "GK" + 24 hex-символа для id
# и 64 hex-символа для секрета (см. infra/garage/init/init.sh) — эти же
# значения передаются backend'у как MINIO_ACCESS_KEY/MINIO_SECRET_KEY.
MINIO_ACCESS_KEY=GK8533518c26b556bb9a9dde7d
MINIO_SECRET_KEY=3918d67710daeb39d6d1b2cd780ae56b7eaa61d884dd0050163a0660dc4d3b88
MINIO_BUCKET=crm-attachments

# ==== Keycloak ====
KEYCLOAK_ADMIN=admin
# ОБЯЗАТЕЛЬНО смените — это пароль администратора Keycloak (полный доступ к realm'ам).
KEYCLOAK_ADMIN_PASSWORD=change-me-strong-password
KEYCLOAK_REALM=it-school-crm
KEYCLOAK_CLIENT_ID=it-school-crm-backend
# На каком адресе публиковать порт Keycloak (8080) наружу. По умолчанию 0.0.0.0
# (доступен со всего интернета) — нужен извне, только если реально используете
# AUTH_MODE=keycloak (браузер должен дотянуться до Keycloak для OIDC-редиректа).
# Для AUTH_MODE=dev поставьте 127.0.0.1, чтобы не светить админку наружу зря.
KEYCLOAK_PUBLISH_ADDR=0.0.0.0

# ==== Backend ====
# dev — роль из заголовка X-Dev-Role (демо/защита, без настоящего логина);
# keycloak — реальная OIDC-авторизация. См. docs/backend-plan.md.
AUTH_MODE=dev
# На каком порту хоста слушать API снаружи (внутри контейнера всегда 3000).
BACKEND_PORT=3000
# Через запятую — origin'ы фронта, которым разрешён CORS. ОБЯЗАТЕЛЬНО
# поменяйте на реальный адрес/домен фронтенда при запуске на сервере —
# иначе браузер с боевого домена получит CORS-ошибку на все запросы к API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:8123
# trace|debug|info|warn|error — structured JSON-логи (pino) в stdout контейнера.
LOG_LEVEL=info
# TTL Redis-кэша GET-эндпоинтов, секунды (при записи кэш сбрасывается сразу).
CACHE_TTL_CATALOGS_SEC=300
CACHE_TTL_DASHBOARD_SEC=60
CACHE_TTL_CHARTS_SEC=180
# always — сеять демо-данными при КАЖДОМ старте контейнера backend (сотрёт то,
#          что накопилось на сервере — только для одноразовых демо-прогонов);
# if-empty — сеять один раз, только если в БД ещё нет ни одного вуза (по умолчанию,
#          безопасно для рестартов уже работающего стенда);
# never — применять миграции, seed не трогать вовсе (реальные пользовательские данные).
SEED_ON_START=if-empty
